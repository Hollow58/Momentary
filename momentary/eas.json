{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "@EXPO_PUBLIC_API_BASE",
        "EXPO_PUBLIC_SPOTIFY_BASE": "@EXPO_PUBLIC_SPOTIFY_BASE",
        "EXPO_PUBLIC_PC_IP": "@EXPO_PUBLIC_PC_IP"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "@EXPO_PUBLIC_API_BASE",
        "EXPO_PUBLIC_SPOTIFY_BASE": "@EXPO_PUBLIC_SPOTIFY_BASE",
        "EXPO_PUBLIC_PC_IP": "@EXPO_PUBLIC_PC_IP"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "@EXPO_PUBLIC_API_BASE",
        "EXPO_PUBLIC_SPOTIFY_BASE": "@EXPO_PUBLIC_SPOTIFY_BASE",
        "EXPO_PUBLIC_PC_IP": "@EXPO_PUBLIC_PC_IP"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
